+def derived_ratios(family: str, parameters: Mapping[str, float]) -> dict[str, float]:
+    """Return the dimensionless ratios that govern the stress concentration.
+
+    The S1 confirmation campaign sampled the raw parameter box uniformly, but the
+    physics is governed by these ratios. Training covered the centre-notched
+    net-section factor only to 1.56 while the evaluation draw reached 2.09, and
+    that gap carried the reported failure. Design and envelope declarations belong
+    in this space, not in the box.
+    """
+    values = _validate_parameters(family, parameters)
+    if family == "dogbone":
+        return {
+            "width_ratio": values["W_grip"] / values["W_gauge"],
+            "fillet_ratio": values["R_fillet"] / values["W_gauge"],
+            "gauge_slenderness": values["L_total"] / values["W_gauge"],
+        }
+    ligament = values["width"] - 2.0 * values["notch_depth"]
+    return {
+        "net_section_factor": values["width"] / ligament,
+        "notch_sharpness": values["notch_depth"] / values["notch_radius"],
+        "relative_depth": 2.0 * values["notch_depth"] / values["width"],
+    }
+
+
+# Extremal criteria per family: the cases hardest to resolve and most likely to
+# drive a verdict. Iteration 8 sampled a fixed stride (family_index 0, 12, 24),
+# which checked convergence on geometries that were never at risk.
+_EXTREMAL_CRITERIA: Final[dict[str, tuple[tuple[str, str], ...]]] = {
+    "dogbone": (
+        ("fillet_ratio", "min"),
+        ("width_ratio", "max"),
+        ("gauge_slenderness", "min"),
+    ),
+    "centre_notched": (
+        ("net_section_factor", "max"),
+        ("notch_sharpness", "max"),
+        ("relative_depth", "max"),
+    ),
+}
+
+
+def select_refinement_geometries(
+    cases: Sequence[SpikeMesh],
+) -> tuple[SpikeMesh, ...]:
+    """Select the extremal geometry per criterion per family, deduplicated."""
+    selected: dict[str, SpikeMesh] = {}
+    for family, criteria in _EXTREMAL_CRITERIA.items():
+        family_cases = sorted(
+            (case for case in cases if case.family == family),
+            key=lambda case: case.geometry_id,
+        )
+        if not family_cases:
+            raise ValueError(f"no cases supplied for {family}")
+        for ratio_name, direction in criteria:
+            chooser = max if direction == "max" else min
+            winner = chooser(
+                family_cases,
+                key=lambda case: derived_ratios(case.family, case.parameters)[
+                    ratio_name
+                ],
+            )
+            selected[winner.geometry_id] = winner
+    return tuple(selected[key] for key in sorted(selected))
