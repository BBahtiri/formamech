+def _triangle_areas(points: FloatArray, cells: IntArray) -> FloatArray:
+    """Return reference-configuration areas for every triangle."""
+    triangles = points[cells]
+    edge_a = triangles[:, 1] - triangles[:, 0]
+    edge_b = triangles[:, 2] - triangles[:, 0]
+    return 0.5 * np.abs(edge_a[:, 0] * edge_b[:, 1] - edge_a[:, 1] * edge_b[:, 0])
+
+
+def area_weighted_nodal_average(
+    element_values: FloatArray,
+    points: FloatArray,
+    cells: IntArray,
+) -> FloatArray:
+    """Recover a nodal field from element values by area-weighted patch average.
+
+    The superseded recovery used an unweighted count average, which biases the
+    notch-root peak low because the elements meeting there are the smallest in the
+    mesh. Weighting by reference area removes that bias and reproduces a constant
+    field exactly.
+    """
+    values = np.asarray(element_values, dtype=np.float64)
+    if len(values) != len(cells):
+        raise ValueError("element_values must supply one entry per cell")
+    areas = _triangle_areas(np.asarray(points, dtype=np.float64), cells)
+    if np.any(areas <= 0.0):
+        raise ValueError("every triangle must have positive reference area")
+    trailing = values.shape[1:]
+    weighted = np.zeros((len(points), *trailing), dtype=np.float64)
+    weights = np.zeros(len(points), dtype=np.float64)
+    broadcast = areas.reshape((-1, *(1,) * len(trailing)))
+    for local_vertex in range(3):
+        vertices = cells[:, local_vertex]
+        np.add.at(weighted, vertices, values * broadcast)
+        np.add.at(weights, vertices, areas)
+    if np.any(weights <= 0.0):
+        raise ValueError("every node must belong to at least one triangle")
+    return weighted / weights.reshape((-1, *(1,) * len(trailing)))
+
+
