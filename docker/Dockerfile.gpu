# syntax=docker/dockerfile:1.7
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        libglu1-mesa \
        libxrender1 \
        libxcursor1 \
        libxft2 \
        libxinerama1 \
        git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY pyproject.toml hatch_build.py README.md LICENSE CITATION.cff CHANGELOG.md uv.lock ./
COPY src ./src
COPY piginot_campaigns ./piginot_campaigns
COPY bundles ./bundles
COPY examples ./examples

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir ".[cad,verify,plot,ui,mcp,export]"

ENTRYPOINT ["formamech"]
CMD ["--help"]
